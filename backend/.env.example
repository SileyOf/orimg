# First install: leave DB_* and JWT_SECRET unset, then open /install.
# The one-time setup code is printed in server logs. No default credentials.
PORT=8080
INSTALL_CONFIG=data/installation.json
UPLOAD_DIR=data/uploads
CACHE_DIR=data/cache
ASSET_DIR=data/site-assets

# Set only the actual reverse proxy IP/CIDR, never all private networks.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Legacy environment-based deployments remain supported. Preserve their original
# JWT_SECRET and paths. Do NOT replace a live .env with this example.
# Defining any DB_HOST / DB_USER / DB_NAME / JWT_SECRET bypasses the wizard.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=origin
# DB_PASSWORD=
# DB_NAME=origin
# DB_TLS=verify
# DB_TLS_CA=
# DB_MAX_OPEN_CONNS=30
# DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME=30m
# JWT_SECRET=
# JWT_EXPIRY=24h
# BASE_URL=https://example.com
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Existing databases attached in the wizard default to paused background work.
# Enable only after checking original mounts, SMTP and storage configuration.
# DISABLE_BACKGROUND_WORK=false

# Storage connections are configured in the admin console after installation.
# STORAGE_MODE=local
# MAX_UPLOAD_MB=20
# CACHE_TTL=720h
# CACHE_CLEANUP_INTERVAL=12h
