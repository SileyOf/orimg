# Docker Compose variables only; never replace an existing application .env.
# Pin a version and change it to upgrade, then: docker compose pull && docker compose up -d
ORIGIN_IMAGE=yuki955/orimg:0.5.2
ORIGIN_PORT=8080
TZ=Asia/Shanghai
# compose.yaml only: exact reverse proxy IP/CIDR. Leave empty until configured.
# (compose.legacy.yaml keeps TRUSTED_PROXIES from legacy.env.)
TRUSTED_PROXIES=
# compose.legacy.yaml only: keep true for the first start after migration.
DISABLE_BACKGROUND_WORK=true
# Only for compose.mysql.yaml. Generate two different random passwords.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
