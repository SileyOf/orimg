# Docker Compose variables only; never replace an existing application .env.
ORIGIN_IMAGE=origin:0.5.1
ORIGIN_PORT=8080
TZ=Asia/Shanghai
# Exact reverse proxy IP/CIDR. Leave empty until configured.
TRUSTED_PROXIES=
# Only for compose.mysql.yaml. Generate two different random passwords.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
