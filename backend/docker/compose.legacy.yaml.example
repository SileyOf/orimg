# Copy to compose.legacy.yaml and review EVERY original path before starting.
services:
  origin:
    env_file:
      - ./legacy.env
    environment:
      # Existing jobs must not run until mounts and storage paths are checked.
      DISABLE_BACKGROUND_WORK: "true"
    volumes:
      - ./data:/app/data
    extra_hosts:
      - host.docker.internal:host-gateway
